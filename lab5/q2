<!DOCTYPE html>
<html>
<head>
    <title>Date and Time</title>
</head>
<body>

    <h2>Current Date and Time</h2>
    <p id="demo"></p>

    <script>
        let currentDate = new Date();

        let date = currentDate.toLocaleDateString();
        let time = currentDate.toLocaleTimeString();

        document.getElementById("demo").innerHTML =
            "Today is: " + date + "<br>" +
            "Current Time: " + time;
    </script>

</body>
</html>
